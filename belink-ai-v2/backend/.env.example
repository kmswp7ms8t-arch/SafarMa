# Server-side only. Never copy secrets into frontend JavaScript, HTML, localStorage or GitHub.
OPENAI_API_KEY=
BELINK_AI_MODEL=gpt-5-mini
BELINK_AI_MAX_TURNS=20
BELINK_CHAT_MAX_TURNS=10
BELINK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BELINK_AI_DATABASE=./data/belink_ai.sqlite3
BELINK_ENV=development
BELINK_REQUIRE_AI=false
BELINK_SESSION_SECRET=
BELINK_REQUIRE_SESSION_SECRET=false
BELINK_RATE_LIMIT=30
BELINK_RATE_WINDOW_SECONDS=60
BELINK_MAX_BODY_BYTES=131072
# Daily connected-AI limits per signed anonymous browser. Set 0 for unlimited.
BELINK_ANALYSES_PER_DAY=5
BELINK_CHATS_PER_DAY=50
# Reuse an identical connected analysis for this many seconds. Set 0 to disable.
BELINK_ANALYSIS_CACHE_SECONDS=900
PORT=8421
